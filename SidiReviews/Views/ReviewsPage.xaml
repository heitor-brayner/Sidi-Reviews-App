<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SidiReviews.Views.ReviewsPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SidiReviews.Views"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:SidiReviews.Components"
    xmlns:model="using:SidiReviews.Model"
    xmlns:viewmodel="using:SidiReviews.ViewModel"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <components:Navbar Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0, 1">
                    <GradientStop Color="#040e1a" Offset="0"/>
                    <GradientStop Color="#10477f" Offset="0.5"/>
                    <GradientStop Color="#040e1a" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Padding="30">
                    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,30">
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="10" MaxWidth="250" MinWidth="200" VerticalAlignment="Top" Margin="0, 0, 10, 0">
                            
                            <Image Source="{Binding CurrentMovie.ImagePath}"
                                   Stretch="Uniform"
                                   MinHeight="300"/>
                            
                            <TextBlock Text="{Binding CurrentMovie.Title}"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Foreground="White" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            
                        </StackPanel>

                        <StackPanel Grid.Column="1"  VerticalAlignment="Top" Margin="10, 0">
                            
                            <TextBlock Text="Sinopse"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="White"
                                       Margin="0,0,0,10"/>
                            
                            <TextBlock Text="{Binding CurrentMovie.Synopsis}"
                                       FontSize="20"
                                       TextWrapping="Wrap"
                                       Foreground="#EEEEEE"
                                       LineHeight="20"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="15"
                                    VerticalAlignment="Top"
                                    MinWidth="200"
                                    Margin="10, 0, 50, 0">
                            
                            <TextBlock Text="Nota Média"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="White"/>
                            
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                
                                <TextBlock Text="{Binding AverageRating}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Bottom"/>
                                
                                <TextBlock Text="/ 5.0"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="#BBBBBB"
                                           VerticalAlignment="Bottom"/>
                            
                            </StackPanel>

                            <ProgressBar Value="{Binding AverageRating}"
                                         Maximum="5"
                                         Minimum="0"
                                         Height="12"
                                         CornerRadius="6"
                                         Margin="0,5,0,0"
                                         Foreground="Gold"
                                         Background="#33FFFFFF"/>
                            
                            <TextBlock Text="{Binding Reviews.Count}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.8"
                                       Foreground="#DDDDDD"/>

                            <Button Content="Adicione uma Review"
                                    Command="{Binding NavigateToAddReviewCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,30,0,0"
                                    Style="{StaticResource AccentButtonStyle}"/>
                            
                        </StackPanel>

                    </Grid>
                    
                    <TextBlock Grid.Row="1"
                               Text="Comentários"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="White"
                               Margin="0,20,0,10"/>

                    <ListView Grid.Row="2"
                              ItemsSource="{Binding Reviews}"
                              SelectionMode="None" 
                              IsItemClickEnabled="False"
                              Background="Transparent"
                              Margin="0,0,0,20">
                        
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="model:Review">
                                <Border Background="#19FFFFFF" CornerRadius="4" Margin="0,0,0,10" Padding="15">
                                    <Grid>
                                        
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                            
                                            <TextBlock Text="{Binding User.UserName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"/>
                                            
                                            <TextBlock Text="{Binding Rating}"
                                                       Foreground="Gold"
                                                       VerticalAlignment="Center"/>
                                        
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="{Binding CreationDate}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Opacity="0.7"
                                                   Foreground="#CCCCCC"
                                                   VerticalAlignment="Center"/>
                                        
                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#EEEEEE"
                                                   Margin="0,10,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>