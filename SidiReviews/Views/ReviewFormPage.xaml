<Page
    x:Class="SidiReviews.Views.ReviewFormPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SidiReviews.Views"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:SidiReviews.Components"
    xmlns:viewmodel="using:SidiReviews.ViewModel"
    mc:Ignorable="d">

    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <components:Navbar Grid.Row="0"/>

        <Grid Grid.Row="1">
            
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0, 1">
                    <GradientStop Color="#040e1a" Offset="0"/>
                    <GradientStop Color="#10477f" Offset="0.5"/>
                    <GradientStop Color="#040e1a" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid Padding="40" MaxWidth="1000" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="250"
                        Height="375"
                        VerticalAlignment="Top"
                        CornerRadius="4"
                        Margin="0,20,40,0">
                    
                    <Image Source="{Binding MovieImagePath}"
                           Stretch="UniformToFill"/>
                    
                </Border>


                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="20">

                        <TextBlock Text="{Binding PageTitle}"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <StackPanel Spacing="5">
                            
                            <TextBlock Text="Comentário:"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="White"/>
                            
                            <TextBox Text="{Binding ReviewContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="200"
                                     MaxHeight="350"
                                     PlaceholderText="Escreva seu comentário aqui..."
                                     Background="#33FFFFFF"
                                     Foreground="White"
                                     BorderThickness="1"
                                     BorderBrush="#66FFFFFF"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            
                            <TextBlock Text="Sua Nota (1-5):"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="White"/>
                            
                            <RatingControl Value="{Binding Rating, Mode=TwoWay}"
                                           MaxRating="5"
                                           PlaceholderValue="0"
                                           IsClearEnabled="False"
                                           Foreground="Gold"/>
                        </StackPanel>

                        <Grid Margin="0,20,0,0">
                            <Button Content="{Binding SaveButtonText}"
                                     Command="{Binding SaveOrUpdateCommand}"
                                     Style="{StaticResource AccentButtonStyle}"
                                     HorizontalAlignment="Stretch"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

            </Grid>

        </Grid>
    </Grid>
</Page>